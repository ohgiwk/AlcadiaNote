{
  "name": "arcadia-ai-textbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "functions:build": "npm --prefix functions run build",
    "test:functions": "npm --prefix functions run build && npm --prefix functions test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-arcadia-test \"node --test firestore.rules.test.mjs\"",
    "test": "npm run test:functions && npm run test:rules",
    "emulators": "firebase emulators:start",
    "deploy": "npm run build && npm run functions:build && firebase deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "firebase": "^12.17.1",
    "framer-motion": "latest",
    "highlight.js": "^11.12.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  }
}
